<?xml version="1.0" encoding="utf-8"?>
<!--
  Headroom MSIX manifest.

  Identity Name / Publisher and PublisherDisplayName come from Partner Center
  once the app name is reserved; build-msix.ps1 substitutes them (and the
  version) at pack time, so the values here are only defaults.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="DannyLamphere.Headroom"
    Publisher="CN=Danny Lamphere"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Headroom</DisplayName>
    <PublisherDisplayName>Danny Lamphere</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>How much of each AI coding plan you have left, from the system tray.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Headroom" Executable="headroom.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Headroom"
        Description="How much of each AI coding plan you have left, from the system tray."
        BackgroundColor="#100E28"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" for a packaged app: the HKCU Run key is
             virtualized under MSIX, so the app toggles this task instead. -->
        <desktop:Extension Category="windows.startupTask" Executable="headroom.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="HeadroomStartup" Enabled="false" DisplayName="Headroom" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
